import liquidity::*;
import states::*;
import structs::*;
import swap::*;

fn action(pool: PoolState, action: Action) -> (PoolState, Wallet) {
    assert action.action == "Swap" || action.action == "deposit" || action.action == "withdraw";
    if action.action == "Swap" {
        swap(pool, action)
    } else {
        calculate_deposit_withdraw(pool, action)
    }
}

fn main() -> (PoolState, Wallet) {
    action(POOL, SWAP)
}

