export fn liquidity0(amount0: Int, sqrt_price: Int, sqrt_upper: Int, scaling_factor: Int) -> Int {
    amount0 * sqrt_price * sqrt_upper / (scaling_factor * (sqrt_upper - sqrt_price))
}

export fn liquidity1(amount1: Int, sqrt_price: Int, sqrt_lower: Int, scaling_factor: Int) -> Int {
    amount1 * scaling_factor / (sqrt_price - sqrt_lower)
}

export fn min(a: Int, b: Int) -> Int {
    if a < b {
        a
    } else {
        b
    }
}

export fn calculate_liquidity(
    amount0: Int,
    amount1: Int,
    sqrt_price: Int,
    sqrt_lower: Int,
    sqrt_upper: Int,
    scaling_factor: Int,
) -> Int {
    if sqrt_price <= sqrt_lower {
        liquidity0(amount0, sqrt_lower, sqrt_upper, scaling_factor)
    } else if sqrt_price >= sqrt_upper {
        liquidity1(amount1, sqrt_upper, sqrt_lower, scaling_factor)
    } else {
        let l0 = liquidity0(amount0, sqrt_price, sqrt_upper, scaling_factor);

        let l1 = liquidity1(amount1, sqrt_price, sqrt_lower, scaling_factor);

        min(l0, l1)
    }
}

export fn round(a: Int, b: Int, round_up: Bool) -> Int {
    assert a >= 0;
    assert b > 0;
    if round_up {
        (a + b - 1) / b
    } else {
        a / b
    }
}

export fn y_from_x(
    amount0: Int,
    current_sqrt_price: Int,
    lower_sqrt_price: Int,
    upper_sqrt_price: Int,
    scaling_factor: Int,
    round_up: Bool,
) -> Int {
    assert current_sqrt_price > lower_sqrt_price;
    assert current_sqrt_price < upper_sqrt_price;

    round(
        amount0 * current_sqrt_price * upper_sqrt_price * (current_sqrt_price - lower_sqrt_price),
        scaling_factor * scaling_factor * (upper_sqrt_price - current_sqrt_price),
        round_up,
    )
}

export fn x_from_y(
    amount1: Int,
    current_sqrt_price: Int,
    lower_sqrt_price: Int,
    upper_sqrt_price: Int,
    scaling_factor: Int,
    round_up: Bool,
) -> Int {
    assert current_sqrt_price > lower_sqrt_price;
    assert current_sqrt_price < upper_sqrt_price;

    round(
        amount1 * scaling_factor * scaling_factor * (upper_sqrt_price - current_sqrt_price),
        (current_sqrt_price - lower_sqrt_price) * current_sqrt_price * upper_sqrt_price,
        round_up,
    )
}

// Only an exact `1` selects `by_y`, so compare to `true` rather than checking truthiness.

export fn calculate_deposit(
    amount0: Int,
    amount1: Int,
    sqrt_price: Int,
    sqrt_lower: Int,
    sqrt_upper: Int,
    scaling_factor: Int,
    by_y: Bool,
    round_up: Bool,
) -> (Int) {
    assert sqrt_lower < sqrt_upper;
    assert sqrt_price >= sqrt_lower;
    assert sqrt_price <= sqrt_upper;

    if sqrt_price == sqrt_lower {
        assert amount0 > 0;
        0
    } else if sqrt_price == sqrt_upper {
        assert amount1 > 0;
        0
    } else if by_y == true {
        assert amount0 > 0;
        y_from_x(amount0, sqrt_price, sqrt_lower, sqrt_upper, scaling_factor, round_up)
    } else {
        assert amount1 > 0;
        x_from_y(amount1, sqrt_price, sqrt_lower, sqrt_upper, scaling_factor, round_up)
    }
}

test fn test_required_amount() {
    let amount = calculate_deposit(
        2000,
        1,
        94878329060,
        94868329805,
        104880884817,
        100000000000,
        false,
        true,
    );

    assert amount == 1006;
}

test fn test_calc_liquidity() {
    let liquidity = calculate_liquidity(
        2000,
        1,
        94878329060,
        94868329805,
        104880884817,
        100000000000,
    );
    assert liquidity == 10000;
}

fn main() -> (Int) {
    calculate_liquidity(90, 100, 100000000000, 94868329805, 104880884817, 100000000000)
}
