import struts::*;

export struct PoolArgs {
    launcher_id: Bytes32,
    token0_id: Bytes32,
    token1_id: Bytes32,

    fee: Int,
    tick_spacing: Int,

    state: PoolState,

    // Puzzle hashes and module hashes
    prelauncher_mod_hash: Bytes32,
    singleton_mod_hash: Bytes32,
    launcher_mod_hash: Bytes32,
    position_mod_hash: Bytes32,
    launcher_puzzle_hash: Bytes32,

    // CAT-wrapped deposit puzzle hashes
    deposit_cat_puzzle_hash0: Bytes32,
    deposit_cat_puzzle_hash1: Bytes32,
}

export struct CreatePositionSolution {
    pool_coin_id: Bytes32,

    // Parent of the zero-mojo prelauncher
    prelauncher_parent_id: Bytes32,

    // Parents of the incoming CAT deposit coins
    deposit0_parent_id: Bytes32,
    deposit1_parent_id: Bytes32,

    owner_puzzle_hash: Bytes32,

    tick_lower: Int,
    tick_upper: Int,

    amount0: Int,
    amount1: Int,
}

struct PositionState {
    liquidity: Int,
}

export fn create_position_conditions(
    args: PoolArgs,
    solution: CreatePositionSolution,
    position_state: PositionState,
) -> List<Condition> {

    // Commit to the exact position and deposits.
    let commitment_data = (
        solution.pool_coin_id,
        (
            solution.owner_puzzle_hash,
            (
                solution.tick_lower,
                (
                    solution.tick_upper,
                    (position_state.liquidity, (solution.amount0, solution.amount1)),
                ),
            ),
        ),
    );

    let commitment = tree_hash(commitment_data);

    // Calculate the custom prelauncher puzzle hash.
    let prelauncher_hash = curry_tree_hash(
        args.prelauncher_mod_hash,
        [
            tree_hash_atom(solution.pool_coin_id),
            tree_hash_atom(commitment),
            tree_hash_atom(args.launcher_puzzle_hash),
        ],
    );

    // Calculate the zero-mojo prelauncher coin ID.
    let prelauncher_coin_id = coinid(solution.prelauncher_parent_id, prelauncher_hash, 0);

    // Calculate the standard singleton launcher ID.
    let position_launcher_id = coinid(prelauncher_coin_id, args.launcher_puzzle_hash, 1);

    // Position inner puzzle.
    let position_inner_hash = curry_tree_hash(args.position_mod_hash, [tree_hash(position_state)]);

    // Standard singleton structure.
    let singleton_struct_hash = tree_hash((
        args.singleton_mod_hash,
        (position_launcher_id, args.launcher_mod_hash),
    ));

    // Full position singleton puzzle hash.
    let position_full_hash = curry_tree_hash(
        args.singleton_mod_hash,
        [singleton_struct_hash, position_inner_hash],
    );

    // ID of the newly created position singleton.
    let position_coin_id = coinid(position_launcher_id, position_full_hash, 1);

    // Expected incoming CAT deposit coin IDs.
    let deposit0_coin_id = coinid(
        solution.deposit0_parent_id,
        args.deposit_cat_puzzle_hash0,
        solution.amount0,
    );

    let deposit1_coin_id = coinid(
        solution.deposit1_parent_id,
        args.deposit_cat_puzzle_hash1,
        solution.amount1,
    );

    // Ensure this is the actual pool coin being spent.
    [
        AssertMyCoinId { coin_id: solution.pool_coin_id },

        // Authorize the exact position creation.
        CreateCoinAnnouncement { message: commitment },

        // Require the prelauncher to be spent.
        AssertConcurrentSpend { coin_id: prelauncher_coin_id },

        // Require the position singleton to be created and spent.
        AssertConcurrentSpend { coin_id: position_coin_id },

        // Require both deposit CAT coins to be spent.
        AssertConcurrentSpend { coin_id: deposit0_coin_id },

        AssertConcurrentSpend { coin_id: deposit1_coin_id },
    ]
}

export struct DepositSolution {
    pool_coin_id: Bytes32,
    commitment: Bytes32,
    amount: Int,
}

fn main(vault_inner_puzzle_hash: Bytes32, solution: DepositSolution) -> List<Condition> {
    let announcement_id = sha256(solution.pool_coin_id + solution.commitment);

    [
        AssertMyAmount { amount: solution.amount },

        AssertCoinAnnouncement { id: announcement_id },

        CreateCoin { puzzle_hash: vault_inner_puzzle_hash, amount: solution.amount, memos: nil },
    ]
}
