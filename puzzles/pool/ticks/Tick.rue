export struct Tick {
    tick_index: Int,
    sqrt_price_scaled: Int,
    liquidity_gross: Int,
    liquidity_net: Int,
    fee_growth_outside0_scaled: Int,
    fee_growth_outside1_scaled: Int,
}

export struct TickCollection {
    ticks: List<Tick>,
}

export struct TickConfig {
    pool_singleton_mod_hash: Bytes32,
    pool_singleton_struct_hash: Bytes32,
}

export struct TickSolution {
    pool_inner_puzzle_hash: Bytes32,
    commitment: Bytes,
    new_ticks: List<Tick>,
}

export struct TickSearchResult {
    found: Bool,
    tick: Tick,
}
