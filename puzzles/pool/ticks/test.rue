import Tick::*;
import tick_accounting::*;

/// This function is nonsenical crap that chaptgpt gave to remove ticks with no L or fees.
export fn validate_old_ticks(old_ticks: List<Tick>, new_ticks: List<Tick>) -> Bool {
    if old_ticks is nil {
        true
    } else {
        let old_tick = old_ticks.first;
        let result = find_tick_at(new_ticks, old_tick.tick_index);

        assert (
            old_tick.liquidity_gross == 0
                && old_tick.fee_growth_outside0_scaled == 0
                && old_tick.fee_growth_outside1_scaled == 0
                && !result.found
        )
            || (old_tick.liquidity_gross > 0 && result.found);

        validate_old_ticks(old_ticks.rest, new_ticks)
    }
}

/// Add more stuff here to calculate new liquidity when new liquidity comes in or gets removed.
export fn liquidity_gross(ticks: List<Tick>, index: Int, liquidity_in: Int) -> Int {
    let c_tick = find_tick_at(ticks, index);
    c_tick.tick.liquidity_gross + liquidity_in
}

fn main(config: TickConfig, state: TickCollection, solution: TickSolution) -> List<Condition> {
    assert validate_old_ticks(state.ticks, solution.new_ticks);

    [ReceiveMessage {
        mode: SENDER_PUZZLE | RECEIVER_PUZZLE,
        message: solution.commitment,
        sender: [config.pool_singleton_mod_hash],
    }]
}

test fn retains_initialized_tick() {
    let new_ticks: List<Tick> = [Tick {
        tick_index: 10,
        sqrt_price_scaled: 100,
        liquidity_gross: 500,
        liquidity_net: 200,
        fee_growth_outside0_scaled: 0,
        fee_growth_outside1_scaled: 0,
    }];

    let old_ticks = [];

    assert validate_old_ticks(old_ticks, new_ticks);
}

test fn access_liquidity_gross() {
    let liquidity = liquidity_gross(TICKS, 20, 3);
    assert liquidity == 603;
}
