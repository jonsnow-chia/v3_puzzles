import struts::*;

export fn withdraw_from_vault(args: VaultArgs, solution: VaultSolution) -> List<Condition> {
    assert solution.amount < args.state.reserve;

    let announcement_id = sha256(
        solution.pool_coin_id + solution.commitment + args.config.pool_launcher_id,
    );

    [
        AssertCoinAnnouncement { id: announcement_id },

        CreateCoin { puzzle_hash: solution.recipient_puzzle_hash, amount: solution.amount },

        CreateCoin {
            puzzle_hash: solution.vault_puzzle_hash,
            amount: args.state.reserve - solution.amount,
        },
    ]
}

export fn deposit_to_vault(args: VaultArgs, solution: VaultSolution) -> List<Condition> {
    let announcement_id = sha256(
        solution.pool_coin_id + solution.commitment + args.config.pool_launcher_id,
    );

    [
        AssertCoinAnnouncement { id: announcement_id },

        CreateCoin {
            puzzle_hash: solution.vault_puzzle_hash,
            amount: args.state.reserve + solution.amount,
        },
    ]
}

// Only an exact `1` selects a deposit, so compare to `true` rather than checking truthiness.

fn main(deposit: Bool, args: VaultArgs, solution: VaultSolution) -> List<Condition> {
    if deposit == true {
        deposit_to_vault(args, solution)
    } else {
        withdraw_from_vault(args, solution)
    }
}
